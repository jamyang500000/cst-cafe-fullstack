# Copy this file to ".env" and fill in your own values.

# Port the API runs on (the frontend runs on 3000)
PORT=5000

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Replace YOUR_PASSWORD with the password you chose when installing PostgreSQL.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/cst_cafe

# Secret used to sign login tokens. Use any long random text.
JWT_SECRET=change-this-to-a-long-random-string

# How long a login lasts before the user must log in again
JWT_EXPIRES_IN=7d

# The frontend's address (allowed to call this API)
CLIENT_ORIGIN=http://localhost:3000

# Optional: if set, staff must enter this code to create a staff account.
# Leave empty while developing.
STAFF_SIGNUP_CODE=
